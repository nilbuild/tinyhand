{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TinyHand",
  "version": "1.1.0",
  "identifier": "app.tinyhand.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' thumb: http://thumb.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "A tiny hand on a stick that points at things on your screen.",
    "copyright": "MIT License",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../../assets/hand_*.png": "hands/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
