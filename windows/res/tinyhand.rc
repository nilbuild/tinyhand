#include <windows.h>
#include "../src/resource.h"
#include "version.h"

IDI_APP ICON "res/tinyhand.ico"

IDR_SOUND_THOCK RCDATA "../assets/sounds/tap_thock.wav"
IDR_SOUND_CLICK RCDATA "../assets/sounds/tap_click.wav"
IDR_SOUND_POP RCDATA "../assets/sounds/tap_pop.wav"
IDR_SOUND_WOOD RCDATA "../assets/sounds/tap_wood.wav"
IDR_SOUND_BOOP RCDATA "../assets/sounds/tap_boop.wav"
IDR_SOUND_SQUEAK RCDATA "../assets/sounds/tap_squeak.wav"

IDR_TRAY_ON RCDATA "../assets/menubar_on@3x.png"
IDR_TRAY_OFF RCDATA "../assets/menubar_off@3x.png"
IDR_APP_PNG RCDATA "res/appicon.png"

1 24 "res/tinyhand.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION TH_VERSION_NUM
PRODUCTVERSION TH_VERSION_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "TinyHand"
            VALUE "FileDescription", "TinyHand"
            VALUE "FileVersion", TH_VERSION_A
            VALUE "InternalName", "TinyHand"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "TinyHand.exe"
            VALUE "ProductName", "TinyHand"
            VALUE "ProductVersion", TH_VERSION_A
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
